# OPENAI_API_KEY: Wajib. API key OpenAI untuk generate gambar kartu.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_IMAGE_MODEL: Opsional. Default: gpt-image-2
# OPENAI_IMAGE_MODEL="gpt-image-2"

# ===== Kuota harian (opsional, ada nilai default) =====
# Maks. kartu per IP per hari (default 3)
# DAILY_LIMIT_PER_IP=3
# Batas total per hari untuk semua pengguna (default 300)
# DAILY_GLOBAL_LIMIT=300
# Zona waktu reset 00.01: WIB=7 (default), WITA=8, WIT=9
# RESET_UTC_OFFSET_HOURS=7
# Teks jam reset yang ditampilkan ke pengguna (default "00.01 WIB")
# RESET_LABEL=00.01 WIB

# Origin tambahan yang diizinkan, pisahkan dengan koma (opsional)
# ALLOWED_ORIGINS=https://playing-card-lac.vercel.app

# Redis Upstash agar hitungan akurat antar instance Vercel (opsional)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=